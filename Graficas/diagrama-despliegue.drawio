        <mxCell id="no_pc" value="&lt;b&gt;PC del usuario — mínimos propuestos&lt;/b&gt;&lt;br&gt;Usuarios: coordinador · director · líder de calidad&lt;br&gt;Windows 10/11 o Linux (RNF-08)&lt;br&gt;JRE 17 + JavaFX&lt;br&gt;CPU 2 núcleos · RAM 4 GB&lt;br&gt;Pantalla ≥ 1366×768 · red con acceso al servidor" style="shape=note;size=14;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="400" height="150" as="geometry"/></mxCell>
        <mxCell id="no_app" value="&lt;b&gt;Servidor de aplicaciones — mínimos propuestos&lt;/b&gt;&lt;br&gt;Ubuntu Server 22.04 LTS · Java 17 (JRE)&lt;br&gt;CPU 2 núcleos · RAM 4 GB&lt;br&gt;Disco 50 GB (archivos de evidencias)&lt;br&gt;Disponibilidad ≥ 99 % en horario laboral (RNF-11)" style="shape=note;size=14;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="600" y="480" width="440" height="150" as="geometry"/></mxCell>
