        <mxCell id="ops" value='&lt;b&gt;&lt;font color="#1F3A5F" style="font-size:13px"&gt;Interfaces y sus operaciones (según los métodos del diagrama de clases)&lt;/font&gt;&lt;/b&gt;&lt;table style="font-size:12.5px;margin-top:6px"&gt;&lt;tr&gt;&lt;td style="padding-right:16px"&gt;&lt;b&gt;IAprobacionPlanes&lt;/b&gt;&lt;/td&gt;&lt;td style="padding-right:60px"&gt;listarPendientes(area) · enviarRevision() · aprobar() · devolver(observacion) · puedeEjecutarse()&lt;/td&gt;&lt;td style="padding-right:16px"&gt;&lt;b&gt;INotificacion&lt;/b&gt;&lt;/td&gt;&lt;td&gt;enviar(destinatario, mensaje)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding-right:16px"&gt;&lt;b&gt;ISeguimientoPlanes&lt;/b&gt;&lt;/td&gt;&lt;td style="padding-right:60px"&gt;agregarActividad(actividad) · cambiarEstado(actividad, estado) · calcularAvance()&lt;/td&gt;&lt;td style="padding-right:16px"&gt;&lt;b&gt;IPersistencia&lt;/b&gt;&lt;/td&gt;&lt;td&gt;guardar(entidad) · buscarPorId(id) · consultar(criterios)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding-right:16px"&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style="padding-right:60px"&gt;registrarSeguimiento(comentario) · puedeFinalizarse() · finalizar(calificacion, observaciones)&lt;/td&gt;&lt;td style="padding-right:16px"&gt;&lt;b&gt;IArchivos&lt;/b&gt;&lt;/td&gt;&lt;td&gt;guardarArchivo(archivo) · descargar(ruta)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding-right:16px"&gt;&lt;b&gt;IBusquedaEvidencias&lt;/b&gt;&lt;/td&gt;&lt;td style="padding-right:60px"&gt;buscar(palabraClave, usuario) · filtrar(tipo, inicio, fin, area, responsable)&lt;/td&gt;&lt;td style="padding-right:16px"&gt;&lt;b&gt;JDBC&lt;/b&gt;&lt;/td&gt;&lt;td&gt;consultas SQL sobre las tablas del modelo relacional&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style="padding-right:16px"&gt;&lt;b&gt;ISeguridad&lt;/b&gt;&lt;/td&gt;&lt;td style="padding-right:60px"&gt;iniciarSesion(correo, contrasena) · tienePermiso(accion)&lt;/td&gt;&lt;td style="padding-right:16px"&gt;&lt;b&gt;&lt;/b&