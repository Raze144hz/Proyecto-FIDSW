@startuml diagrama-procesos-hu017
' Diagrama de procesos de HU-017 y HU-004: aprobación y seguimiento de un plan de acción.
' Para generar la imagen, desde la carpeta Graficas: java -jar plantuml.jar -tpng -o .. fuentes/diagrama-procesos-hu017.puml
!theme plain
skinparam defaultFontName DejaVu Sans
skinparam shadowing false
skinparam dpi 150
skinparam conditionStyle diamond

title Diagrama de Procesos - Aprobación (HU-017) y seguimiento (HU-004) de un plan de acción

|Coordinador|
start
:Registrar el plan de acción
(objetivo, área y fechas);
|Sistema SGPI|
:Asignar código único
y dejar el plan en BORRADOR;
|Coordinador|
:Enviar el plan a revisión;
|Sistema SGPI|
:Cambiar a PENDIENTE DE REVISION
y registrar el cambio en el historial;
|Director de área|
:Revisar el plan de su área;
while (¿El plan es correcto?) is (no)
  :Escribir las observaciones
  y devolver el plan;
  note right: Las observaciones\nson obligatorias.
  |Sistema SGPI|
  :Cambiar a EN REVISION,
  guardar las observaciones
  y notificar al coordinador;
  |Coordinador|
  :Corregir el plan, marcar cada
  observación como atendida
  y reenviarlo a revisión;
  |Sistema SGPI|
  :Cambiar a PENDIENTE DE REVISION
  y registrar el cambio en el historial;
  |Director de área|
  :Revisar el plan corregido;
endwhile (sí)
:Aprobar el plan;
|Sistema SGPI|
:Cambiar a APROBADO
y notificar al coordinador;
|Coordinador|
:Iniciar la ejecución;
|Sistema SGPI|
:Cambiar a EN EJECUCION;
|Coordinador|
:Registrar el seguimiento
(porcentaje de avance y comentario);
|Sistema SGPI|
:Guardar el seguimiento
y recalcular el avance del plan;
|Coordinador|
while (¿El avance llegó al 100 %?) is (no)
  |Coordinador|
  :Registrar un nuevo seguimiento;
  |Sistema SGPI|
  :Guardar el seguimiento
  y recalcular el avance del plan;
endwhile (sí)
|Coordinador|
:Finalizar el plan;
|Sistema SGPI|
:Cambiar a FINALIZADO;
stop
@enduml
