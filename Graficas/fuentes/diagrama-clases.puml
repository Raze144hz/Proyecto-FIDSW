@startuml diagrama-clases
' Diagrama de clases del SGPI para HU-016 (búsqueda de evidencias), HU-017 (aprobación de planes),
' HU-004 (seguimiento del avance por actividades) y HU-020 (cierre y evaluación final).
' Para generar la imagen, desde la carpeta Graficas: java -jar plantuml.jar -tpng -o .. fuentes/diagrama-clases.puml
!theme plain
skinparam classAttributeIconSize 0
skinparam defaultFontName DejaVu Sans
skinparam shadowing false
skinparam classFontStyle bold
skinparam dpi 170
skinparam nodesep 40
skinparam ranksep 70
hide circle
hide empty members

title Diagrama de Clases - Búsqueda de evidencias, Aprobación, Seguimiento y Cierre de planes de acción

class Usuario {
  -idUsuario : int
  -nombre : String
  -correo : String
  -contrasena : String
  +iniciarSesion(correo : String, contrasena : String) : boolean
  +tienePermiso(accion : String) : boolean
}

class Rol {
  -idRol : int
  -nombre : String
  +getNombre() : String
}

class Area {
  -idArea : int
  -nombre : String
  +getNombre() : String
}

class Evidencia {
  -idEvidencia : int
  -nombre : String
  -tipoArchivo : String
  -fechaCarga : Date
  -palabrasClave : String
  -ruta : String
  +descargar() : File
}

class Busqueda {
  -palabraClave : String
  -tipoArchivo : String
  -fechaInicio : Date
  -fechaFin : Date
  +buscar(palabraClave : String, usuario : Usuario) : List<Evidencia>
  +filtrar(tipo : String, inicio : Date, fin : Date, area : Area, responsable : Usuario) : List<Evidencia>
}

class PlanAccion {
  -idPlan : int
  -codigo : String
  -objetivo : String
  -fechaInicio : Date
  -fechaFin : Date
  -estado : EstadoPlan
  -fechaEnvio : Date
  -calificacionCierre : int
  -observacionesCierre : String
  -fechaCierre : Date
  +enviarRevision() : void
  +aprobar() : void
  +devolver(observacion : String) : void
  +puedeEjecutarse() : boolean
  +iniciarEjecucion() : void
  +agregarActividad(actividad : Actividad) : void
  +calcularAvance() : int
  +registrarSeguimiento(comentario : String) : void
  +puedeFinalizarse() : boolean
  +finalizar(calificacion : int, observaciones : String) : void
}

class Actividad {
  -idActividad : int
  -descripcion : String
  -fechaLimite : Date
  -estado : EstadoActividad
  +cambiarEstado(nuevo : EstadoActividad) : void
  +tieneEvidencia() : boolean
}

enum EstadoActividad <<enumeration>> {
  POR_HACER
  EN_PROCESO
  FINALIZADA
}

enum EstadoPlan <<enumeration>> {
  BORRADOR
  PENDIENTE_REVISION
  EN_REVISION
  APROBADO
  EN_EJECUCION
  FINALIZADO
  --
  -estado : String
  --
  +getEstado() : String
  +esEditable() : boolean
}

class Observacion {
  -idObservacion : int
  -descripcion : String
  -fecha : Date
  -atendida : boolean
  +marcarAtendida() : void
}

class Notificacion {
  -idNotificacion : int
  -mensaje : String
  -fecha : Date
  -leida : boolean
  +enviar() : void
  +marcarLeida() : void
}

class SeguimientoPlan {
  -idSeguimiento : int
  -fecha : Date
  -avanceCalculado : int
  -comentario : String
  +getAvanceCalculado() : int
}

class HistorialPlan {
  -idHistorial : int
  -codigoPlan : String
  -accion : String
  -estadoAnterior : EstadoPlan
  -estadoNuevo : EstadoPlan
  -detalle : String
  -fecha : Date
}

Usuario "0..*" --> "1" Rol : tiene
Usuario "0..*" --> "1" Area : pertenece
Usuario "1" -- "0..*" Evidencia : responsable >
Busqueda ..> Usuario : <<use>>
Area "1" -- "0..*" Evidencia : clasifica >
Busqueda ..> Evidencia : <<use>>

Usuario "1" -- "0..*" PlanAccion : coordinador >
Usuario "0..1" -- "0..*" PlanAccion : director >
PlanAccion "0..*" --> "1" Area : área responsable
PlanAccion --> EstadoPlan
PlanAccion "1" *-- "0..*" Observacion : contiene
Usuario "1" -- "0..*" Observacion : autor >
PlanAccion "1" --> "0..*" Notificacion : genera
Notificacion "0..*" --> "1" Usuario : destinatario
PlanAccion "0..1" --> "0..*" HistorialPlan : registra
PlanAccion "1" *-- "0..*" Actividad : contiene
Actividad "0..*" --> "1" Usuario : responsable
Actividad --> EstadoActividad
Actividad "1" -- "0..*" Evidencia : soportada por >
PlanAccion "1" *-- "0..*" SeguimientoPlan : tiene
SeguimientoPlan "0..*" --> "1" Usuario : registrado por
HistorialPlan "0..*" --> "1" Usuario : realizado por

note top of PlanAccion
  HU-004: calcularAvance() = actividades FINALIZADA × 100 / total de
  actividades. Una actividad solo pasa a FINALIZADA si tiene evidencia (CU-03).
  HU-020: solo el director del área finaliza el plan, cuando el avance
  es 100 %, y registra la calificación y las observaciones de cierre.
end note

note bottom of SeguimientoPlan
  Corte de seguimiento: el coordinador escribe
  el comentario y el sistema guarda el avance
  calculado en esa fecha. No se digita.
end note

note bottom of HistorialPlan
  Se conserva si el plan se elimina:
  guarda el código del plan y en la BD
  no tiene llave foránea a PLAN_ACCION.
end note
@enduml
