ll=0;startFill=0;endSize=10;startSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_plan_accion_id_plan" target="t_seguimiento_plan_id_plan"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1356" y="113"/><mxPoint x="1356" y="1137"/></Array></mxGeometry></mxCell><mxCell id="r_seguimiento_plan_id_usuario" style="rounded=1;jumpStyle=arc;jumpSize=8;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=10;startSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_usuario_id_usuario" target="t_seguimiento_plan_id_usuario"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="916" y="113"/><mxPoint x="916" y="1163"/></Array></mxGeometry></mxCell><mxCell id="r_historial_plan_id_usuario" style="rounded=1;jumpStyle=arc;jumpSize=8;html=1;endArrow=ERzeroToMany;startArrow=ERmandOne;endFill=0;startFill=0;endSize=10;startSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="t_usuario_id_usuario" target="t_historial_plan_id_usuario"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="396" y="113"/><mxPoint x="396" y="605"/></Array></mxGeometry></mxCell><mxCell id="nota0" value="Modelo Relacional - Base de Datos SGPI (modelo objetivo, PostgreSQL 16)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="900" height="40" as="geometry"/></mxCell><mxCell id="nota1" value="HISTORIAL_PLAN: id_plan y codigo_plan no son llave foránea; el historial se conserva si el plan se elimina (RNF-10)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="1226" width="300" height="110" as="geometry"/></mxCell><mxCell id="nota2" value="CORREO (HU-015): cada NOTIFICACION también sale por correo según USUARIO.frecuencia_correo (INMEDIATA, DIARIA a las 7:00 o DESACTIVADA). HU-005: los avisos de vencimiento a 5 días y a 1 día son NOTIFICACION y siguen la misma regla." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="510" y="1226" width="300" height="110" as="geometry"/></mxCell><mxCell id="nota3" value="ACTIVIDAD: avance del plan (HU-004) = actividades FINALIZADA / total; se calcula con la vista avance_plan, no se guarda." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="980" y="1226" width="300" height="110" as="geometry"/></mxCell><mxCell id="nota4" value="PK = llave primaria · FK = llave foránea · UK = valor único · (opcional) = admite NULL" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1450" y="1226" width="300" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
