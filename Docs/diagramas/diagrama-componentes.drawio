        <mxCell id="ops" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Interfaces y sus operaciones (según los métodos del diagrama de clases)&lt;/font&gt;&lt;/b&gt;&lt;table style=&quot;font-size:12.5px;margin-top:6px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;padding-right:16px&quot;&gt;&lt;b&gt;IBusquedaEvidencias&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding-right:60px&quot;&gt;buscar(palabraClave, usuario) · filtrar(criterio, usuario)&lt;/td&gt;&lt;td style=&quot;padding-right:16px&quot;&gt;&lt;b&gt;IRepositorios&lt;/b&gt;&lt;/td&gt;&lt;td&gt;IRepositorioPlanes · IRepositorioEvidencias&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding-right:16px&quot;&gt;&lt;b&gt;IAprobacionPlanes&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding-right:60px&quot;&gt;listarPendientes(director) · aprobar(idPlan, director) · devolver(idPlan, director, observacion)&lt;/td&gt;&lt;td style=&quot;padding-right:16px&quot;&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td&gt;IRepositorioNotificaciones&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding-right:16px&quot;&gt;&lt;b&gt;ISeguimientoPlanes&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding-right:60px&quot;&gt;calcularAvance(idPlan) · cambiarEstado(idActividad, nuevo, usuario)&lt;/td&gt;&lt;td style=&quot;padding-right:16px&quot;&gt;&lt;b&gt;IArchivos&lt;/b&gt;&lt;/td&gt;&lt;td&gt;guardarArchivo(archivo) · descargar(ruta)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding-right:16px&quot;&gt;&lt;b&gt;&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding-right:60px&quot;&gt;registrarSeguimiento(idPlan, comentario, usuario)&lt;/td&gt;&lt;td style=&quot;padding-right:16px&quot;&gt;&lt;b&gt;JDBC&lt;/b&gt;&lt;/td&gt;&lt;td&gt;consultas SQL a la base de datos (TCP 5432)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding-right:16px&quot;&gt;&lt;b&gt;IControlAcceso&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding-right:60px&quot;&gt;tienePermiso(usuario, accion)&lt;/td&gt;&lt;td style=&quot;padding-right:16px&quot;&gt;&lt