        <mxCell id="no_pc" value="&lt;b&gt;PC del usuario — mínimos propuestos&lt;/b&gt;&lt;br&gt;Usuarios: director, coordinador, líder de calidad&lt;br&gt;Windows 10/11 o Linux (RNF-08)&lt;br&gt;CPU 2 núcleos · RAM 4 GB&lt;br&gt;Pantalla ≥ 1366×768 · red con acceso al servidor" style="shape=note;size=14;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="520" width="380" height="130" as="geometry"/></mxCell>
